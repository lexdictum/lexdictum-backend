# Application
APP_NAME=LexDictum API
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=case_document_chunks

# Redis (arq workers)
REDIS_URL=redis://localhost:6379/0

# Optional direct Postgres (local dev alongside Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lexdictum

# LLM (OpenAI-compatible: OpenAI, OpenRouter, local vLLM, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# RAG
RAG_TOP_K=5
RAG_MAX_CONTEXT_MESSAGES=20
RAG_USE_HYBRID_SEARCH=false
RAG_RRF_K=60

# Embeddings (local in-process or remote HTTP service)
EMBEDDING_PROVIDER=local
EMBEDDING_SERVICE_URL=
EMBEDDING_MODEL_NAME=nlpaueb/legal-bert-base-uncased

# Production hardening
SENTRY_DSN=
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_ENABLED=true

# OCR (optional — requires uv sync --extra ocr and system tesseract)
OCR_ENABLED=false
TESSERACT_LANG=spa

# OpenTelemetry (optional — uv sync --extra observability)
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

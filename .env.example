# Application
APP_NAME=LexDictum API
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=case_document_chunks

# Redis (arq workers)
REDIS_URL=redis://localhost:6379/0

# Optional direct Postgres (local dev alongside Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lexdictum

# Staging environment — copy to .env.staging and fill secrets
APP_NAME=LexDictum API
APP_ENV=staging
DEBUG=false
CORS_ORIGINS=["https://staging.lexdictum.es"]

# Supabase (staging project)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SUPABASE_JWT_SECRET=your-staging-jwt-secret-min-32-chars

# Infrastructure (docker-compose.staging.yml service names)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=case_document_chunks
REDIS_URL=redis://redis:6379/0

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# RAG / embeddings
RAG_TOP_K=5
RAG_MAX_CONTEXT_MESSAGES=20
RAG_USE_HYBRID_SEARCH=false
RAG_RRF_K=60
EMBEDDING_PROVIDER=local
EMBEDDING_SERVICE_URL=
EMBEDDING_MODEL_NAME=nlpaueb/legal-bert-base-uncased

# Hardening
SENTRY_DSN=
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_ENABLED=true

# OCR (worker image: set WORKER_INSTALL_OCR=1 in compose when enabling)
OCR_ENABLED=false
TESSERACT_LANG=spa
WORKER_INSTALL_OCR=0

# Observability (start with: docker compose --profile observability up -d)
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=staging
